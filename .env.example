# === 1. EMAIL ADMIN (pisahkan koma jika lebih dari 1) ===
ADMIN_EMAILS=emailkamu@gmail.com

# === 2. FIREBASE CLIENT (dari Project Settings -> Web App) ===
FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXX
FIREBASE_AUTH_DOMAIN=project-kamu.firebaseapp.com
FIREBASE_PROJECT_ID=project-kamu
FIREBASE_APP_ID=1:123456789:web:abcdef123456

# === 3. FIREBASE ADMIN SDK (dari Project Settings -> Service Accounts -> Generate New Private Key) ===
# Cukup paste isi 1 baris JSON service account di bawah ini:
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxx@project-kamu.iam.gserviceaccount.com"}

# === 4. OPSIONAL (Semua ini bisa langsung diatur dari Website Admin /admin!) ===
# CHESTPAY_APIKEY=isi_apikey_chestpay
# VPN_DOMAIN=sg1.domainkamu.com
# VPN_AUTH=api_auth_panel
